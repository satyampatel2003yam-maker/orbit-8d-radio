# Copy this file to .env and fill in your own values before running the server.
# Never commit the real .env file.

# Pick any admin username you want
ADMIN_USERNAME=admin

# Generate a bcrypt hash for your password by running: npm run setup-admin
# It will ask for a password and print the hash to paste here.
ADMIN_PASSWORD_HASH=

# Any long random string - used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-string

# Port the server runs on
PORT=3000
